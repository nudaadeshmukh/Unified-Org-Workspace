generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("TICKETS_DATABASE_URL")
}

// No cross-schema FKs to identity.User/Organization by design — orgId/userId
// here are opaque UUIDs trusted only via the verified JWT (CLAUDE.md rule #1),
// not enforced at the DB level across service boundaries.

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(uuid())
  orgId       String
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?
  createdBy   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments    Comment[]
  attachments Attachment[]
  shares      TicketShare[]

  @@index([orgId])
}

model Comment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

// fileUrl is a relative path (e.g. "/uploads/<uuid>-<originalname>"), served via
// express.static — see implementation_guide.md Phase 3. Not an absolute URL.
model Attachment {
  id         String   @id @default(uuid())
  ticketId   String
  uploadedBy String
  fileUrl    String
  fileName   String
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

// revokedAt set (soft-revoke), never hard-deleted — see api_reference.md.
model TicketShare {
  id           String    @id @default(uuid())
  ticketId     String
  partnerOrgId String
  sharedBy     String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@index([partnerOrgId])
}

// Read-only for this build; flags set via seed data (Phase 3).
model FeatureFlag {
  id        String   @id @default(uuid())
  orgId     String
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([orgId, key])
  @@index([orgId])
}

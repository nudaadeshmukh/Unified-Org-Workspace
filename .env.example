# =============================================================================
# Froncort Unified Org Workspace — environment template
# Copy to .env (root) and to each packages/<service>/.env as needed.
# Never commit the real .env — see .gitignore.
# =============================================================================

NODE_ENV=development

# ----- Postgres ---------------------------------------------------------
# One Postgres instance, one DB ("froncort"), separate schema per service —
# documented trade-off, see docs/known-limitations.md.
# These are MIGRATION/OWNER connections (full DDL rights).
IDENTITY_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/froncort?schema=identity"
TICKETS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/froncort?schema=tickets"
PRS_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/froncort?schema=prs"
AUDIT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/froncort?schema=audit"

# audit-service RUNTIME connection — must use the restricted `audit_writer`
# role (INSERT+SELECT only, see packages/audit-service/prisma/append-only.sql).
# Run migrations with AUDIT_DATABASE_URL above, run the live service with this one.
AUDIT_RUNTIME_DATABASE_URL="postgresql://audit_writer:change-me-in-production@localhost:5432/froncort?schema=audit"

# ----- Redis --------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# ----- JWT (RS256) ----------------------------------------------------------
# Generate the keypair with scripts/generate-jwt-keys.sh, then base64-encode
# each PEM file into these env vars. Locked decision: env vars, not a shared
# file path — Railway deploys each service to a separate host with no shared
# filesystem, so a file path would break in production even though it works
# locally. identity-service uses JWT_PRIVATE_KEY to sign; ticket-service,
# pr-service, and audit-service only ever need JWT_PUBLIC_KEY to verify.
JWT_PRIVATE_KEY=base64-encoded-PEM-private-key-here
JWT_PUBLIC_KEY=base64-encoded-PEM-public-key-here
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Scope the refresh cookie to the parent domain in production so both
# dashboards share one session. Leave blank for local dev (localhost).
COOKIE_DOMAIN=

# ----- Service-to-service auth ------------------------------------------
INTERNAL_API_KEY=change-me-shared-secret

# ----- Service ports & internal URLs -------------------------------------
IDENTITY_PORT=4001
TICKETS_PORT=4002
PRS_PORT=4003
AUDIT_PORT=4004

IDENTITY_SERVICE_URL=http://localhost:4001
TICKET_SERVICE_URL=http://localhost:4002
PR_SERVICE_URL=http://localhost:4003
AUDIT_SERVICE_URL=http://localhost:4004

# ----- CORS ----------------------------------------------------------------
# Comma-separated allowlist — never use "*". Update to real domains on deploy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ----- AI digest (Groq) ------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17 (confirmed via
# Groq's docs at Phase 5 build time, per implementation_guide.md's "verify
# exact model string against Groq's docs at build time" instruction).
# openai/gpt-oss-120b is Groq's own migration recommendation for it — also
# gets automatic prompt caching on Groq, worth noting given the digest job's
# repeated system-prompt structure across users/orgs.
GROQ_MODEL=openai/gpt-oss-120b
AI_DIGEST_INTERVAL_HOURS=6
# Heuristic only — Ticket has no real due-date field (see ticket.service.js
# schema). A ticket counts as "overdue" for digest purposes if it's still
# OPEN/IN_PROGRESS and older than this many days. Not a literal due-date
# comparison; flagged for docs/known-limitations.md at Phase 9.
TICKET_OVERDUE_THRESHOLD_DAYS=3

# ----- Frontend (consumed by Next.js apps — must be prefixed NEXT_PUBLIC_) --
NEXT_PUBLIC_IDENTITY_API_URL=http://localhost:4001
NEXT_PUBLIC_TICKET_API_URL=http://localhost:4002
NEXT_PUBLIC_PR_API_URL=http://localhost:4003
NEXT_PUBLIC_AUDIT_API_URL=http://localhost:4004
